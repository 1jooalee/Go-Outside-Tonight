<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Go Outside Tonight</title>
  <style>
    :root {
      --bg: #0b0e14;
      --card-bg: rgba(255, 255, 255, 0.05);
      --border: rgba(255, 255, 255, 0.1);
      --text: #f0f4f8;
      --accent: #79c0ff;
      --green: #7ee787;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      text-align: center;
    }

    .container {
      max-width: 420px;
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 32px 24px;
      backdrop-filter: blur(12px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .tag {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--accent);
      margin-bottom: 12px;
      font-weight: 600;
    }

    h1 {
      font-size: 36px;
      font-weight: 700;
      margin-bottom: 16px;
      line-height: 1.1;
    }

    .verdict {
      font-size: 48px;
      font-weight: 800;
      color: var(--green);
      margin: 20px 0;
    }

    p {
      font-size: 16px;
      line-height: 1.5;
      color: #a3b3c2;
      margin-bottom: 24px;
    }

    .event-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px;
      margin-bottom: 24px;
      text-align: left;
    }

    .event-title {
      font-size: 18px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 4px;
    }

    .event-time {
      font-size: 13px;
      color: var(--accent);
      margin-bottom: 8px;
    }

    .btn {
      background: #fff;
      color: #000;
      border: none;
      padding: 14px 28px;
      font-size: 16px;
      font-weight: 600;
      border-radius: 99px;
      cursor: pointer;
      transition: transform 0.1s ease;
      width: 100%;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .status {
      font-size: 13px;
      margin-top: 16px;
      opacity: 0.6;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="tag">Tonight's Sky Check</div>
    <div id="verdict" class="verdict">YES</div>
    <h1 id="headline">Step outside tonight.</h1>
    
    <div class="event-card">
      <div id="event-title" class="event-title">Jupiter & Moon Alignment</div>
      <div id="event-time" class="event-time">Best view: 9:00 PM - 11:30 PM</div>
      <p id="event-desc" style="margin-bottom:0; font-size:14px;">Jupiter will appear as a bright golden star directly next to the moon. Clear skies are predicted in your area.</p>
    </div>

    <button class="btn" onclick="checkSky()">Re-check My Sky</button>
    <div id="status" class="status">Checking local cloud cover...</div>
  </div>

  <script>
    async function checkSky() {
      const status = document.getElementById('status');
      status.innerText = "locating...";

      if (!navigator.geolocation) {
        status.innerText = "Geolocation not supported. Showing general forecast.";
        return;
      }

      navigator.geolocation.getCurrentPosition(async (pos) => {
        const lat = pos.coords.latitude;
        const lon = pos.coords.longitude;
        status.innerText = "Checking local weather...";

        try {
          // Fetch real weather using free Open-Meteo API
          const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&hourly=cloudcover&forecast_days=1`);
          const data = await res.json();
          const currentHour = new Date().getHours();
          const cloudCover = data.hourly.cloudcover[currentHour] || 20;

          if (cloudCover < 50) {
            document.getElementById('verdict').innerText = "YES";
            document.getElementById('verdict').style.color = "#7ee787";
            document.getElementById('headline').innerText = "Clear skies tonight.";
            status.innerText = `Local cloud cover is only ${cloudCover}%. Perfect visibility.`;
          } else {
            document.getElementById('verdict').innerText = "MAYBE";
            document.getElementById('verdict').style.color = "#ffa657";
            document.getElementById('headline').innerText = "Partly cloudy tonight.";
            status.innerText = `Local cloud cover is ${cloudCover}%. You might catch breaks in the clouds.`;
          }
        } catch (e) {
          status.innerText = "Unable to fetch live weather. Using estimated forecast.";
        }
      }, () => {
        status.innerText = "Location permission denied. Showing default view.";
      });
    }

    // Run automatically on load
    checkSky();
  </script>

</body>
</html>
